<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Subtitle ~#B8B8B8 @ 100% opacity; service log slightly darker for de-emphasis -->
  <Color x:Key="Color.Surface">#FF1A1A1C</Color>
  <Color x:Key="Color.Panel">#FF252528</Color>
  <Color x:Key="Color.Text">#FFE8E8E8</Color>
  <Color x:Key="Color.Subtitle">#FFB8B8B8</Color>
  <Color x:Key="Color.ServiceLog">#FF888888</Color>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.Subtitle" Color="{StaticResource Color.Subtitle}"/>
  <SolidColorBrush x:Key="Brush.ServiceLogText" Color="{StaticResource Color.ServiceLog}"/>

  <Style TargetType="Button">
    <Setter Property="Background" Value="#3A3A3E"/>
    <Setter Property="Foreground" Value="#F3F3F3"/>
    <Setter Property="BorderBrush" Value="#5C5C62"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#4A4A50"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="40" CenterY="12"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="#EEEEEE"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd"
                  Background="#38383C"
                  BorderBrush="#5A5A60"
                  BorderThickness="1,1,1,0"
                  CornerRadius="8,8,0,0"
                  Margin="3,4,3,0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="PART_Header"
                              ContentSource="Header"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#2A2A2E"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#7C7C86"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="False"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="#45454A"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="#2A2A2E"/>
    <Setter Property="Foreground" Value="#F5F5F5"/>
    <Setter Property="BorderBrush" Value="#5A5A60"/>
    <Style.Resources>
      <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2A2A2E"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F5F5F5"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2A2A2E"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F5F5F5"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82C4"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#4A4A52"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#EDEDED"/>
    </Style.Resources>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Background" Value="#2A2A2E"/>
    <Setter Property="Foreground" Value="#EDEDED"/>
    <Style.Resources>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82C4"/>
      <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
    </Style.Resources>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#252528"/>
    <Setter Property="Foreground" Value="#EDEDED"/>
    <Setter Property="CaretBrush" Value="#FFFFFF"/>
    <Setter Property="SelectionBrush" Value="#3B82C4"/>
    <Setter Property="BorderBrush" Value="#5A5A60"/>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#EDEDED"/>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="#252528"/>
    <Setter Property="Foreground" Value="#E6E6E6"/>
    <Setter Property="BorderBrush" Value="#5A5A60"/>
    <Setter Property="RowBackground" Value="#252528"/>
    <Setter Property="AlternatingRowBackground" Value="#2C2C30"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#3A3A40"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#333338"/>
    <Setter Property="Foreground" Value="#F5F5F5"/>
    <Setter Property="BorderBrush" Value="#5A5A60"/>
    <Setter Property="Padding" Value="8,6"/>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Foreground" Value="{StaticResource Brush.ServiceLogText}"/>
    <Setter Property="Background" Value="#1F1F22"/>
    <Setter Property="BorderBrush" Value="#5A5A60"/>
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Brush.ServiceLogText}"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>

  <Style TargetType="GroupBox">
    <Setter Property="BorderBrush" Value="#5A5A60"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>
</ResourceDictionary>
